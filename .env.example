# Copy to .env and edit. `docker compose up -d` reads this file automatically.

# Directory that CONTAINS your video folders. Mounted read-write at
# /videos_parent inside the container.
PARENT_DIRECTORY=/srv/media

# The folder inside PARENT_DIRECTORY to open on startup.
VIDEO_FOLDER=videos

# Comma-separated addresses or CIDR blocks allowed to reach the server.
# This is a network filter, not authentication - do not expose this port to
# the internet and rely on it.
ALLOWED_IPS=127.0.0.1,::1,192.168.0.0/16

# Comma-separated addresses of reverse proxies whose X-Forwarded-For header
# may be believed. Leave empty unless you actually run one.
TRUSTED_PROXIES=

# Optional Gelbooru API credentials, from Account -> Options -> API Access
# Credentials. Only needed for gelbooru.com post URLs; leave empty and the
# post page is read instead.
GELBOORU_API_KEY=
GELBOORU_USER_ID=

# Host port to publish.
PORT=6969
